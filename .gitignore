# raft-personas — allowlist: nothing is tracked unless named here.
# A new persona dropped into this folder stays OUT until it is added on purpose;
# that is the point. ai-panic/ and sylvia_maath/ are scraped writing by living
# authors and must not be published without their say; effort/ is empty.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/NOTICE.md
!/LICENSES/
!/raft-darwin/

# ---------- junk ----------
.DS_Store
__pycache__/
*.pyc
*.tmp
*.swp

# ---------- sensitive: never, anywhere ----------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.netrc
*secret*
*credential*
opbdh.json
.opbdh/
.claude/

# ============ inside raft-darwin ============

# ---------- RUN 2 (post-Origin -> 1868) IS STILL BEING WRITTEN: hands off ----------
# Add these in a follow-up once the run has finished. Nothing here is read,
# moved or zipped by the import.
/raft-darwin/reports/1859-post-origin/
/raft-darwin/reports/1860/
/raft-darwin/reports/1861/
/raft-darwin/reports/1862/
