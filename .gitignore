/raft-darwin/reports/1867/
/raft-darwin/reports/1868/
/raft-darwin/reports/research/
/raft-darwin/reports/raft-prep/run-02*/
# One writer for shared status and accepted annotations; live during run 2.
/raft-darwin/data/annotations/

# ---------- not retained: the corpus itself (see EXCLUDED_MANIFEST.json) ----------
# Pair records, provenance, verdicts and ledgers ARE tracked; the bulk text they
# were derived from is not, and the manifest says how to rebuild or verify it.
/raft-darwin/data/raw/
*.pdf
/raft-darwin/reports/raft-prep/rendered-staging.working.json
/raft-darwin/reports/raft-export/inputs/rendered-staging.json

# ---------- regenerable / scratch ----------
chroma/
chroma.pristine/
*.sqlite3
/raft-darwin/darwin_split_arm3/
**/corpus/chunks.jsonl
**/conversations/finetune.json
**/conversations/finetune.openai.jsonl
**/conversations/hf-run/

