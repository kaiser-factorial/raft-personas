    {
      "case": "1980 Sunday and November 1 conflict",
      "source_ids": [
        "DCP-LETT-1980"
      ],
      "requirement": "Preserve the supplied/editorial date [1 November 1856] together with the header’s Sunday wording and the accepted calendar conflict: 1 November 1856 was Saturday; 2 November was Sunday. Do not silently choose November 2 or treat the footnote’s first-Sunday rationale as proof. The two diagrams and the body’s Hooker enquiry, daily Gärtner use and carapace terminology debate retain their own body/apparatus boundaries.",
      "exact_source_evidence": [
        {
          "letter_id": "DCP-LETT-1980",
          "body_paragraph": 1,
          "quote": "I have written to Hooker to enquire.",
          "char_start": 0,
          "char_end": 36,
          "source_sha256": "15e3728c05df9e16b770a3679acbdf9edcc9536907e68b9d1b6fa5e8c06ab84f",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div[1]/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-1980",
          "body_paragraph": 3,
          "quote": "But I demur vehemently to your calling the under membrane of carapace “Corium”",
          "char_start": 0,
          "char_end": 78,
          "source_sha256": "15e3728c05df9e16b770a3679acbdf9edcc9536907e68b9d1b6fa5e8c06ab84f",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div[1]/div[1]/div[2]/p[4]"
        }
      ],
      "source_provenance": [
        {
