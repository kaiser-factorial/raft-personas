    {
      "case": "1913 uncertain July date and within-letter vertebra correction",
      "source_ids": [
        "DCP-LETT-1913"
      ],
      "requirement": "Retain the XML/editorial date as July 1856 without selecting a day. Keep P3 and P9 together: P3 reports a casual, explicitly non-quotable impression of an extra cervical vertebra while reserving uncertainty about the back; P9 later retracts confidence as a possible simple blunder because the neck was not cleaned. Do not replace either stage with the later twelve-cervical published result, and keep the planned paper/show material separate from completed findings.",
      "exact_source_evidence": [
        {
          "letter_id": "DCP-LETT-1913",
          "body_paragraph": 3,
          "quote": "With respect to vertebræ, I shd. not like to be quoted;",
          "char_start": 0,
          "char_end": 55,
          "source_sha256": "6bbb3406dae0a2a35251bb7b0bcb6f7cf083060a8a8d5230d94333ada78f523b",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[4]"
        },
        {
          "letter_id": "DCP-LETT-1913",
          "body_paragraph": 3,
          "quote": "they certainly seemed to have an extra neck vertebra;",
          "char_start": 92,
          "char_end": 145,
          "source_sha256": "6bbb3406dae0a2a35251bb7b0bcb6f7cf083060a8a8d5230d94333ada78f523b",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[4]"
        },
        {
          "letter_id": "DCP-LETT-1913",
          "body_paragraph": 9,
          "quote": "I have just looked at skeleton & I believe I have made simple blunder; but the neck has not been well cleaned & I cannot make out certainly.",
          "char_start": 5,
          "char_end": 145,
          "source_sha256": "6bbb3406dae0a2a35251bb7b0bcb6f7cf083060a8a8d5230d94333ada78f523b",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[10]"
        }
      ],
