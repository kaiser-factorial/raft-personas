    {
      "case": "1935 open August range",
      "source_ids": [
        "DCP-LETT-1935"
      ],
      "requirement": "Represent 1935 as [15–22 August 1856], not an exact day. The clear Runt chart is acknowledged but its text is unavailable; the Victoria/Smyrna assessment is conditional and concerns proportions rather than beauty. The later dead-Runt acceptance in 1943 is a subsequent practical decision and must not erase the earlier open range or missing chart.",
      "exact_source_evidence": [
        {
          "letter_id": "DCP-LETT-1935",
          "body_paragraph": 1,
          "quote": "I write one line merely to thank you for your most clear chart of the Runts.",
          "char_start": 0,
          "char_end": 76,
          "source_sha256": "e4ad5e1bf90689934094514e7b44e28a29e5df07436d38e270a77fa2eea19e63",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-1935",
          "body_paragraph": 1,
          "quote": "I do not think they differ in proportions & that is my sole object.",
          "char_start": 243,
          "char_end": 310,
          "source_sha256": "e4ad5e1bf90689934094514e7b44e28a29e5df07436d38e270a77fa2eea19e63",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-1935",
          "body_paragraph": 2,
          "quote": "Far from thinking that you treated me “cavalierly” at Anerly",
          "char_start": 0,
          "char_end": 60,
          "source_sha256": "e4ad5e1bf90689934094514e7b44e28a29e5df07436d38e270a77fa2eea19e63",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[3]"
        }
      ],
