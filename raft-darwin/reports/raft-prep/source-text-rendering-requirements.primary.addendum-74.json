      "figure_assets": [
        {
          "letter_id": "DCP-LETT-2427",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div[1]/div[1]/div[2]/p[7]/span[6]/img",
          "figure_path": "data/raw/dcp/1858-1859/figures/DCP-LETT-2427-1.jpg",
          "sha256": "a09b5cf78724c86751ef533593d4643239968c1f68004b25914a1cce6ad52aa6"
