    },
    {
      "batch": "43",
      "source_ids": [
        "DCP-LETT-2596"
      ],
      "requirement": "Render the Horner letter as a complete social and book-related reply, preserving its thanks, health and invitation passages rather than reducing it to a geological keyword. The source has a supplied 23 December 1859 date and a separate editorial note; neither identifies an omitted incoming letter beyond Darwin’s reference.",
      "evidence": [
        {
          "body_paragraph": 1,
          "quote": "I must have the pleasure of thanking you for your extreemly kind letter.",
          "dom_locator": "#letter .body-content > p:nth-of-type(4)"
        }
      ],
      "date_voice_hold": "Darwin voice; receipt of Horner’s letter is explicit, but response scope is limited to the surviving text.",
      "source_paths": {
