    {
      "batch": "41",
      "source_ids": [
        "DCP-LETT-2359"
      ],
      "requirement": "The Gardeners’ Chronicle item is a long Darwin-authored experimental argument. Preserve its numbered notes and the distinction between Darwin’s own bean observations and the quoted New Zealand report; an editorial title or authority key does not replace the body. Its date is a supplied-before bound, so no exact composition or receipt should be rendered.",
      "evidence": [
        {
          "body_paragraph": 1,
          "quote": "Last year you published a brief notice by me on this subject.",
          "dom_locator": "#letter .body-content > p:nth-of-type(1)"
        }
      ],
      "date_voice_hold": "Darwin voice; source-level publication/letter metadata and any incoming Gould prompt remain separate.",
      "source_paths": {
        "DCP-LETT-2359": "data/raw/dcp/1844-1846/pages/DCP-LETT-2359.html"
      },
      "source_html_sha256": {
        "DCP-LETT-2359": "78e4a661539e30c2597c267bba63e08b47497cf3940da566fa318f6a656e1363"
      }
    },
    {
      "batch": "42",
      "source_ids": [
        "DCP-LETT-2201F"
      ],
      "requirement": "Preserve this F-suffixed Darwin source as a surviving letter with its bird observations and separate editorial notes. F is an identifier, not proof that the body is a fragment. Keep the dated heading and the prose/footnote layers separate; no missing recipient prompt may be reconstructed from the summary.",
      "evidence": [
        {
          "body_paragraph": 1,
          "quote": "I went yesterday & saw your birds, which I am glad to see got a prize.",
          "dom_locator": "#letter .body-content > p:nth-of-type(4)"
        }
      ],
      "date_voice_hold": "Darwin-authored outgoing; later publication references do not establish a new-period incoming.",
      "source_paths": {
        "DCP-LETT-2201F": "data/raw/dcp/1858-1859/pages/DCP-LETT-2201F.html"
