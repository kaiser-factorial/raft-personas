      }
    },
    {
      "batch": "44",
      "source_ids": [
        "DCP-LETT-2469B"
      ],
      "requirement": "Preserve the company’s multi-line share-capital and dividend figures as ordered tabular prose. The printed financial notation contains stacked fractions and quoted stock labels; retain the MathML/line structure and do not silently normalize it into ordinary decimal numbers. This is a third-party company response, not Darwin’s scientific voice.",
      "evidence": [
