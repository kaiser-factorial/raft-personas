          "kind": "verified_apparatus",
          "literal_text": "were added to the bottom of the page by CD and were presumably copied from the missing part of Hooker’s letter.",
          "sha256": null,
          "source_sha256": "5fc0723016d6250f2d1a85fc94b3f54e5e1860ca0ef4c2110af4d8d05db40ac6"
