  "requirements": [
    {
      "source_id": "DCP-LETT-2445",
      "requirement": "Retain repeated raw sentence exactly and avoid deduplicating the repeated sentence during rendering; preserve its paragraph boundary.",
      "evidence": {
        "quote": "I am much obliged for your note, & accept with pleasure your offer. But I feel bound for your sake (& my own) to say in clearest terms, that if after looking over part of M.S. you do not think it likely to have a remunerative sale, I completely & explicitly free you from your offer. But you will see that it would be a stigma on my work for from your offer. But you will see that it would be a stigma on my work for you to advertise it, & then not publish it. My volume cannot be mere light reading, & some parts must be dry & some rather abstruse; yet as far I can judge perhaps very falsely, it will be interesting to all (& they are many) who care for the curious problem of the origin of all animate forms.—",
        "locator": "first substantive retained body paragraph",
        "html_path": "data/raw/dcp/1858-1859/pages/DCP-LETT-2445.html",
        "html_sha256": "0236216fca617e4fde957734e15eed550c7209218e92e96bc4af97b700192e10"
      },
      "recommendation": "fail closed on unsupported or missing markup; preserve literal source token and section boundary."
    },
    {
      "source_id": "DCP-LETT-2513A",
      "requirement": "Render currency and fraction notation literally from the source, keeping any superscript markers distinct from ordinary digits.",
      "evidence": {
        "quote": "By this day’s post I send you a specimen copy of your book bound— I hope it may receive your approval. Please reply by return & not a moment shall be lost in getting ready the early copies—your instructions seem quite clear & shall be carefully followed.",
        "locator": "first substantive retained body paragraph",
        "html_path": "data/raw/dcp/1858-1859/pages/DCP-LETT-2513A.html",
        "html_sha256": "cdb900b30f4a2e380b57fd7210540c73934a9a89994de15076d72b7ddf62bf36"
      },
      "recommendation": "fail closed on unsupported or missing markup; preserve literal source token and section boundary."
    },
    {
      "source_id": "DCP-LETT-2514",
      "requirement": "Keep this receipt/approval prose separate from 2513A; inspect its superscript/currency layer without merging the two letters.",
      "evidence": {
        "quote": "I have received your kind note & the copy: I am infinitely pleased & proud at the appearance of my child.—2 I quite agree to all you propose about price. But you are really too generous about the to me scandalously heavy corrections. Are you not acting unfairly towards yourself? Would it not be better to at least share the £72’s 80? 3 I shall be fully satisfied; for I had no business to send, though quite unintentionally & unexpectedly, such badly composed M.S. to the printers.",
        "locator": "first substantive retained body paragraph",
        "html_path": "data/raw/dcp/1858-1859/pages/DCP-LETT-2514.html",
        "html_sha256": "5e62cc6c508f99ae76106696fa97f18b248f1e6c924c62cc925910e141604049"
      },
      "recommendation": "fail closed on unsupported or missing markup; preserve literal source token and section boundary."
    },
    {
      "source_id": "DCP-LETT-2566",
      "requirement": "Blank proposed notice is an absent artifact: render an explicit unavailable/blank hold and do not invent the notice text.",
      "evidence": {
        "quote": "Mess rs. Clowes received a lot of sheets last Monday & now I have got all ready; so time will depend on Printers alone.— I have made some few corrections, & have inserted capital sentence from Rev. C. Kingsley in answer to anyone who may, as many will, say that my Book is irreligious.1 I have told Mess rs. Clowes they must keep paging of the two Editions uniform, even if they repeat one or two numbers on pages as I cannot make a new index.",
        "locator": "first substantive retained body paragraph",
        "html_path": "data/raw/dcp/1858-1859/pages/DCP-LETT-2566.html",
        "html_sha256": "b7ff153ff35432c672b230d9f3d64331f2adb7bfcd1f1407239a7babb0083092"
      },
      "recommendation": "fail closed on unsupported or missing markup; preserve literal source token and section boundary."
