      ],
      "exact_source_evidence": [
        {
          "letter_id": "DCP-LETT-2159",
          "body_paragraph": 1,
          "quote": "At page 688 of the “abominable” catalogue you will find Encyclopaedias.",
          "char_start": 0,
          "char_end": 71,
          "source_sha256": "32bfae92970a4adc54c9ba6da0e547c5cbd2ee783b6fbfa58b095dd93943195c",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-2159",
          "body_paragraph": 5,
          "quote": "I can send the other books named in your List",
          "char_start": 0,
          "char_end": 45,
          "source_sha256": "32bfae92970a4adc54c9ba6da0e547c5cbd2ee783b6fbfa58b095dd93943195c",
