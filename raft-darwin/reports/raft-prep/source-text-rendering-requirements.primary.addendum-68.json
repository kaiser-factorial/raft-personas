  "requirements": [
    {
      "case": "2159 embedded Darwin request and White response",
      "source_ids": [
        "DCP-LETT-2159"
      ],
      "requirement": "Separate White’s library/search and book-sending response from the embedded Darwin request pasted in retained P5 (raw p6). “Vol II & IV, if in Library” is Darwin voice inside White’s body, while White’s own claim is that he can send other named books; the original full request is missing and its date is not fixed by this reply. Preserve the uncertain 1746-93 book identification, undated Osbeck reading intention. Keep trailing address in provenance only and exclude it from eventual body.",
      "source_provenance": [
        {
          "letter_id": "DCP-LETT-2159",
          "source_path": "data/raw/dcp/1856-1857/pages/DCP-LETT-2159.html",
