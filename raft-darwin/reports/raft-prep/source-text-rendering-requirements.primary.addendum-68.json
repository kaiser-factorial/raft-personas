    {
      "case": "1998 copied Darwin enclosure and genus/species limits",
      "source_ids": [
        "DCP-LETT-1998"
      ],
      "requirement": "Distinguish Westwood’s seven retained letter blocks from the separate two-paragraph enclosure/list copied in Darwin’s hand, not as an all-Westwood or all-Darwin document. Tellkampf’s descriptions are explicitly inadequate; Adelops is only generically identical with European species, not the same species. Preserve ditto dashes, taxon spellings, copied questions and Westwood corrections without reconstructing the exact missing cover. Wallich’s translation is recommended because Westwood thinks Darwin has not seen it, but that is not proof of Darwin non-reading. The August 4, 1852 newspaper issue date is source bibliography, not query composition date; P7 place/date layers remain excluded from future body.",
      "source_provenance": [
        {
          "letter_id": "DCP-LETT-1998",
          "source_path": "data/raw/dcp/1856-1857/pages/DCP-LETT-1998.html",
          "source_html_sha256": "23be2a13e9ca30fafa472ebf357c3c1962b5014cc7c8489ae78b6bda4f17592a",
          "xml_path": "data/raw/epsilon/ab0d973bae05b54d68d82d068211015996cfec06/expansions/1856-1857/letters/DCP-LETT-1998.xml",
          "xml_sha256": "958ea73afa6671f6f2f47a2e4ee7790f06d48a7be465aecc9d662e8b7ab53781",
          "verified_xml_dates": [
            {
              "text": "23 Nov 1856",
              "attributes": {
                "when": "1856-11-23"
              },
              "lower": "1856-11-23",
              "upper": "1856-11-23",
              "xml_fragment": "<ns0:date xmlns:ns0=\"http://www.tei-c.org/ns/1.0\" when=\"1856-11-23\">23 Nov 1856</ns0:date>"
            }
          ]
        }
      ],
      "exact_source_evidence": [
        {
          "letter_id": "DCP-LETT-1998",
          "body_paragraph": 1,
          "quote": "The descriptions given by Tellkampf of the insects found by him in the Kentucky Cave are not sufficiently precise",
          "char_start": 0,
          "char_end": 113,
          "source_sha256": "23be2a13e9ca30fafa472ebf357c3c1962b5014cc7c8489ae78b6bda4f17592a",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div[1]/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-1998",
          "body_paragraph": 2,
          "quote": "His adelops is however evidently identical generically with the European species",
          "char_start": 0,
          "char_end": 80,
          "source_sha256": "23be2a13e9ca30fafa472ebf357c3c1962b5014cc7c8489ae78b6bda4f17592a",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div[1]/div[1]/div[2]/p[3]"
        },
        {
          "letter_id": "DCP-LETT-1998",
          "body_paragraph": 3,
          "quote": "I cannot do better than refer you to Dr Wallich’s Translation",
          "char_start": 0,
          "char_end": 61,
          "source_sha256": "23be2a13e9ca30fafa472ebf357c3c1962b5014cc7c8489ae78b6bda4f17592a",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div[1]/div[1]/div[2]/p[4]"
        }
      ],
      "enclosure_source": {
        "section_class": "enclosures",
        "locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div[1]/div[2]",
        "text": "[Enclosure]4Lepdoderus Hohenwarti (Coleopt? new Fam.)5 —— angustatus —— sericeus Pristonychus6 elegans var. Schreibersi is this blind?7 Blothrus Schiödtii (scorpion)8 Titanethes albus (oniscus like) Polydesmus subteraneus Niphargus stygius (allied to Polydesmus)9 Anurophurus stillicidii (do?)10 Phalangopsis caricola. Grasshopper Cavicularia anophthalma (spider) Phalangium cancroides (do)11 Adelops12 Khavenhulleri13 (Coleopt.)14 Anophtalmus stomoides (Coleopt.) ——— Bilimeki15 ——— Scopolii16 F. J. Schmidt | “Laibacher Zeitung” | Nor 146. 4 Aug 1852."
      }
    },
