    {
      "case": "Andersson photocopy and missing proof sheets",
      "source_ids": [
        "DCP-LETT-1845F",
        "DCP-LETT-1850"
      ],
      "requirement": "Render 1845F as Darwin’s four-page photocopy of an ALS with surviving body only; its statement that proof sheets were received and 32 pages assessed does not make the complete book or proof sheets available. 1850 is an incomplete fragment whose P1 answers only 1845F P5’s “beau ideal” question, with comparative claims attributed to Andersson; the cattle answer is missing and the puma/lion query is an additional prompt. Exclude the addressee heading and annotations; preserve the authentic authorial valediction separately from the addressee, rather than deleting both indiscriminately.",
      "exact_source_evidence": [
        {
          "letter_id": "DCP-LETT-1845F",
          "body_paragraph": 1,
          "quote": "I am very much obliged to you for the Proof sheets, received this morning.",
          "char_start": 0,
          "char_end": 74,
          "source_sha256": "897f7986bcdd64ea419e4db838fd2176085e948aee2150561dcc181ce6a76f06",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-1845F",
          "body_paragraph": 5,
          "quote": "or have they a different beau ideal?",
          "char_start": 226,
          "char_end": 262,
          "source_sha256": "897f7986bcdd64ea419e4db838fd2176085e948aee2150561dcc181ce6a76f06",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[6]"
        },
        {
          "letter_id": "DCP-LETT-1850",
          "body_paragraph": 1,
          "quote": "with regard to the beau ideal satisfactorily",
          "char_start": 0,
          "char_end": 44,
