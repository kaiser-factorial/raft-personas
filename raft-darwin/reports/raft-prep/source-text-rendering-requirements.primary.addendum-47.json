    {
      "case": "Davidson receipt actor and response scope",
      "source_ids": [
        "DCP-LETT-2021",
        "DCP-LETT-2024"
      ],
      "requirement": "Record 2024 P1–P2 as Davidson answering Darwin 2021, a reverse relationship and not a Darwin-target conversation. “Received only yesterday morning” records Thomas Davidson’s receipt of Darwin’s 23 December letter on 28 December, not Darwin’s receipt of the 29 December reply. Preserve composition date, recipient, receipt actor and knowledge boundaries separately; 2024 P3–P4 are additional Bouchard/project context.",
      "exact_source_evidence": [
        {
          "letter_id": "DCP-LETT-2021",
          "body_paragraph": 1,
          "quote": "a variable species is or is not equally variable at all times & places",
          "char_start": 401,
          "char_end": 471,
          "source_sha256": "e95c2c0a31d3b24ed667c111f69c23512026ca3d68f7a209fa9382f868ebad93",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-2024",
          "body_paragraph": 1,
          "quote": "your kind note of the 23d. which I received only yesterday morning",
          "char_start": 23,
          "char_end": 89,
          "source_sha256": "07cf12597106493fb1c208fecf6dce955b42e9823757039343495804c40b5d51",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div[1]/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-2024",
          "body_paragraph": 1,
          "quote": "a variable Species is so in all localities however distant",
