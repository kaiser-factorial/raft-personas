    {
      "id": "r57-recommendation-audience",
      "topic": "recommendation and audience changes",
      "requirement": "Keep DCP-LETT-2093F and DCP-LETT-2100 as separate Darwin institutional recommendations. 2093F contains a conditional Prestwich recommendation and a counterfactual Lyell judgment; 2100 records a later Hooker report that Lindley was proposed and clarifies that Darwin’s earlier letter was read to Council although he thought it private. Preserve the shift in audience and recommendation; do not rewrite counterfactuals as endorsements by Lyell or Hooker.",
      "source_ids": [
        "DCP-LETT-2093F",
        "DCP-LETT-2100"
      ],
      "exact_source_evidence": [
        {
          "letter_id": "DCP-LETT-2093F",
          "body_paragraph": 1,
          "quote": "If I had been on council, I think I would have proposed him, & in that case I shd. have got Lyell’s opinion & judgment, as the most capable judge living on such a subject;",
          "char_start": 612,
          "char_end": 783,
          "source_sha256": "42f8de363d9fb64ea3adde74d9c6e9d20fbde75a165aac589c091fe4883afd41",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-2100",
          "body_paragraph": 2,
          "quote": "Hooker tells me that my letter to you was read to the Council: I had thought that you had asked merely for my private opinion,—all that I said in that letter expressed my deliberate conviction, whatever that may be worth, but I am rather alarmed that I expressed myself dogmatically under the impression that I was writing to a private friend & not to a Body like the Council of the Royal Soc.y.",
          "char_start": 33,
          "char_end": 428,
          "source_sha256": "d59d637440fc2a7bdaf8e60accd9542e4e46767c7cd243f815c725e9bbe7a7e8",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[3]"
        }
      ],
      "source_provenance": [
