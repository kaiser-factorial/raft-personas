  "requirements": [
    {
      "case": "2175F complete ALS, oral report and pending Bishop recovery",
      "source_ids": [
        "DCP-LETT-2175F"
      ],
      "requirement": "Treat 2175F as a complete five-block Darwin ALS despite its F suffix. The Lubbock/Bate report is orally received, and Darwin asks detailed questions about species, specimen, insertion duration/depth and cirri/valve behaviour, water conditions and observer identity; his request to forward the note is prospective. Keep the 30 November/1 December cover/postmark distinction from the 29 November composition. Bishop-to-Bate2179 has now been recovered and admitted separately as a scoped routed response, not an automatically delivered Darwin prompt or Darwin voice.",
      "source_provenance": [
        {
          "letter_id": "DCP-LETT-2175F",
          "source_path": "data/raw/dcp/1856-1857/pages/DCP-LETT-2175F.html",
          "source_html_sha256": "8184361c9b573c1abdea3ee473929e212c2ea560f022880f016d0e6844cd280f",
          "xml_path": "data/raw/epsilon/ab0d973bae05b54d68d82d068211015996cfec06/expansions/1856-1857/letters/DCP-LETT-2175F.xml",
          "xml_sha256": "620a7d6a8d43352b4b2c85538daeccabe5fb1f4a8e80f8a1d670913a1b85ae49",
          "verified_xml_dates": [
            {
              "text": "29 Nov [1857]",
              "attributes": {
                "when": "1857-11-29"
              },
              "lower": "1857-11-29",
              "upper": "1857-11-29",
              "xml_fragment": "<ns0:date xmlns:ns0=\"http://www.tei-c.org/ns/1.0\" when=\"1857-11-29\">29 Nov [1857]</ns0:date>"
            }
          ]
        }
      ],
      "exact_source_evidence": [
        {
          "letter_id": "DCP-LETT-2175F",
          "body_paragraph": 1,
          "quote": "Mr Lubbock told me yesterday of a fact, observed, I believe, by a friend of yours",
          "char_start": 0,
          "char_end": 81,
          "source_sha256": "8184361c9b573c1abdea3ee473929e212c2ea560f022880f016d0e6844cd280f",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-2175F",
          "body_paragraph": 2,
          "quote": "Which was the species; if not known could I see a specimen of the kind.",
          "char_start": 63,
          "char_end": 134,
          "source_sha256": "8184361c9b573c1abdea3ee473929e212c2ea560f022880f016d0e6844cd280f",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[3]"
        },
        {
          "letter_id": "DCP-LETT-2175F",
          "body_paragraph": 3,
          "quote": "Perhaps the simplest plan wd. be to forward this note to your friend",
          "char_start": 93,
          "char_end": 161,
          "source_sha256": "8184361c9b573c1abdea3ee473929e212c2ea560f022880f016d0e6844cd280f",
