      "verified_currency_markup": {
        "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[3]",
        "raw_markup": "<p>I really now think I shall have materials to judge of Poultry of World, for M<sup>r</sup> Wallace is collecting in the Malay Archipelago;<sup id=\"back-mark-Lfoot.f4\" class=\"footnote\" data-target=\"#Lfoot.f4\">4</sup> but the carriage is costing me a fortune! The Persian Box alone cost <sup>£</sup>4 <sup>s</sup> 4 <sup>d</sup> 10.—</p>\n",
