              },
              "lower": "1856-11-03",
              "upper": "1856-11-03",
              "xml_fragment": "<ns0:date xmlns:ns0=\"http://www.tei-c.org/ns/1.0\" when=\"1856-11-03\">3 Nov [1856]</ns0:date>"
            }
          ]
        }
      ],
      "exact_source_evidence": [
        {
          "letter_id": "DCP-LETT-1981",
          "body_paragraph": 4,
          "quote": "I have received from the Honble. Walter Elliot of Madras, skins of following poultry, diag 2. Game Cock & Hen (of great size)",
          "char_start": 21,
          "char_end": 146,
          "source_sha256": "096508cd8591ae0182a0b5daee1b2944f960d74365953bd2b83f8b40f790e9ad",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[5]"
        },
        {
          "letter_id": "DCP-LETT-1981",
          "body_paragraph": 9,
          "quote": "Now if you would like to examine & describe these 9 skins",
          "char_start": 0,
          "char_end": 57,
          "source_sha256": "096508cd8591ae0182a0b5daee1b2944f960d74365953bd2b83f8b40f790e9ad",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[10]"
        }
      ],
      "verified_raw_layout": [
        {
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[5]",
          "raw_markup": "<p>Since writing to you I have received from the Hon<sup>ble</sup>. Walter Elliot of Madras, <span class=\"underline\">skins</span> of following poultry, diag 2. Game Cock &amp; Hen (of great size)</p>\n"
        },
        {
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[9]",
          "raw_markup": "<p>People.ramme</p>\n"
        }
      ]
