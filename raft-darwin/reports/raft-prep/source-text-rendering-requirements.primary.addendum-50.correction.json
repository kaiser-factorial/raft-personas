    {
      "source_ids": [
        "DCP-LETT-1981"
      ],
      "case": "five-category nine-skin list and raw layout",
      "requirement": "Preserve the five categories and nine skins in 1981, including the doubtful Rangoon origin of one cock. Darwin explicitly says he has received these skins; his proposed loan to Tegetmeier and required return of the wild Jungle Fowl head are prospective. Preserve raw diag/ramme tokens in audit evidence only. The final entry requires a source-supported clean list rendering with category associations intact; unresolved layout artifacts hold it. No image, table or MathML exists in the raw letter to substitute automatically.",
      "source_provenance": [
        {
          "letter_id": "DCP-LETT-1981",
          "source_path": "data/raw/dcp/1856-1857/pages/DCP-LETT-1981.html",
          "source_html_sha256": "096508cd8591ae0182a0b5daee1b2944f960d74365953bd2b83f8b40f790e9ad",
          "xml_path": "data/raw/epsilon/ab0d973bae05b54d68d82d068211015996cfec06/expansions/1856-1857/letters/DCP-LETT-1981.xml",
          "xml_sha256": "0de0c16e7be6d967ac5cd62c86d669e162a4c171654b81e56f0b18898d0f30c5",
          "verified_xml_dates": [
            {
              "text": "3 Nov [1856]",
              "attributes": {
