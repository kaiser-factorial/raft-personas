          "xml_path": "data/raw/epsilon/ab0d973bae05b54d68d82d068211015996cfec06/expansions/1858-1859/letters/DCP-LETT-2457.xml",
          "xml_sha256": "9756560256e45dcb350e4f3c3e37a85a94d8e188319d32a463d8a9b93ff090db",
          "verified_xml_dates": [
            {
              "text": "3 May [1859]",
              "attributes": {
                "when": "1859-05-03"
              },
              "lower": "1859-05-03",
              "upper": "1859-05-03",
              "xml_fragment": "<ns0:date xmlns:ns0=\"http://www.tei-c.org/ns/1.0\" when=\"1859-05-03\">3 May [1859]</ns0:date>"
            }
          ]
        }
      ],
      "verified_enclosure_groups": [
        {
          "index": 1,
          "paragraphs": [
            {
              "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div[1]/div[2]/div[1]/p[1]",
              "text_without_footnote_markers": "Revd S. Haughton Address to Geolog. Soc. Dublin"
            },
            {
              "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div[1]/div[2]/div[1]/p[2]",
              "text_without_footnote_markers": "“This speculation of Mess. Darwin & Wallace would not be worthy of notice, were it not for the weight of authority of names (ie Lyell’s & yours) under whose auspices it has been brought forward. If it means what it says, it is a truism; if it means anything more, it is contrary to fact.”—"
            },
            {
              "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div[1]/div[2]/div[1]/p[3]",
              "text_without_footnote_markers": "Q. E. D.—"
            }
          ]
        },
        {
          "index": 2,
          "paragraphs": [
            {
              "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div[1]/div[2]/div[2]/p",
              "text_without_footnote_markers": "Since writing the enclosed note, I have thought I would expand a little on the subject of Reversion for my Abstract; & I send it uncorrected, as you may possibly like to see what I say. Please return it soon; but I am not quite sure whether or not I shall insert it. I have already separately touched on most of the points.—"
            }
          ]
        },
        {
          "index": 3,
          "paragraphs": [
            {
              "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div[1]/div[2]/div[3]/p",
              "text_without_footnote_markers": "P.S. 2d. | I return by this Post A. Gray, which I have just read.— I see he adopts the notion I sent him, of the homogeniety of the flora on the circumpolar land before the Glacial period, when the climate was warmer, & there was an open highway— What rubbish, Agassiz talks.—"
            }
          ]
        }
      ]
    },
