      "primary_dom_evidence": [
        {
          "letter_id": "DCP-LETT-1704",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[5]",
          "raw_html": "<p>I have just ordered Almond Tumblers &amp; Runts, so I shall have soon a grand collection of Pigeons.—</p>\n",
          "source_sha256": "32d28a249b247775cc9e372186a2e47c29fd266aa17b604cef412181ae30687b"
        },
        {
          "letter_id": "DCP-LETT-1733",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[4]",
          "raw_html": "<p>Thank you for extract from Wood:<sup id=\"back-mark-Lfoot.f3\" class=\"footnote\" data-target=\"#Lfoot.f3\">3</sup> I shall get the Book.— I quite agree in probability of what you say about the Breeds of Dogs;<sup id=\"back-mark-Lfoot.f4\" class=\"footnote\" data-target=\"#Lfoot.f4\">4</sup> but there are many who would not, &amp; therefore I am anxious to get as many precise facts as I can about crossing, both for this object, &amp; generally for the comparison of mongrels &amp; Hybrids.</p>\n",
          "source_sha256": "b8357b767bd0fefdb245f34ee693fd6b8c4f5e6a6013c2ba7d3c5e4043f74e8d"
        }
      ]
    },
