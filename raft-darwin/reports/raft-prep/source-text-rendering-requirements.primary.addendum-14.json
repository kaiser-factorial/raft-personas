        "ledger_path": "data/annotations/periods/1851-1855/batch-22.json",
        "ledger_sha256": "ff84fa3787436e4bb417602b67f0c797b155dbda3bf6458bbdbf5f0116480101",
        "accepted_note": "1745 August 22 and 1766 October 14: raw HTML contains diag/ramme fragments around numbered specimen lists; no image/table node. Preserve list order and damage.",
        "accepted_decision": "dated_grounding_unpaired; no fabricated figure/table or repair.",
