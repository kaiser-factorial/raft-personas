          "letter_id": "DCP-LETT-1704",
          "body_paragraph": 1,
          "quote": "I have received safely the young Duckling",
          "source_sha256": "32d28a249b247775cc9e372186a2e47c29fd266aa17b604cef412181ae30687b"
        },
        {
          "letter_id": "DCP-LETT-1733",
          "body_paragraph": 3,
          "quote": "Thank you for extract from Wood: I shall get the Book.",
