        {
          "letter_id": "DCP-LETT-1526",
          "body_paragraph": 1,
          "quote": "hope that your poor little girl may be spared",
          "char_start": 271,
          "char_end": 316,
          "source_sha256": "fefd85b5091e029258dcee5839af8c35c3ec8a7193d3fb6ecaf190dae684aa06"
