    {
      "case": "3059 unanswered Erhardt request and later Variation information",
      "source_ids": [
        "DCP-LETT-3059"
      ],
      "requirement": "Keep 3059 as a Darwin ALS dated 4 February [1856] by relational apparatus, not by catalogue number. Darwin reports Norton Shaw’s lead, his own unanswered request to Reverend Erhardt for East African domestic-animal information, and asks Galton to exert influence without requiring a reply. Later Variation information about Erhardt’s observation belongs to a later publication witness and must not backdate a response or fabricate the missing Shaw/Erhardt letters. Preserve the questioned body spelling Erdhardt(?) and the authoritative Erhardt identification in apparatus as separate layers.",
      "source_provenance": [
        {
          "letter_id": "DCP-LETT-3059",
          "source_path": "data/raw/dcp/1856-1857/pages/DCP-LETT-3059.html",
          "source_html_sha256": "a0e2905eb9ba1322246acdbfbc24331b2d674d3d8d4fc298349830e853522e65",
          "xml_path": "data/raw/epsilon/ab0d973bae05b54d68d82d068211015996cfec06/expansions/1856-1857/letters/DCP-LETT-3059.xml",
          "xml_sha256": "c7d93ae2682cedeef0d53576671fe42bc501f4beae53d7c921c17bde5d9bc51e",
          "verified_xml_dates": [
            {
              "text": "4 Feb [1856]",
              "attributes": {
                "when": "1856-02-04"
              },
              "lower": "1856-02-04",
              "upper": "1856-02-04",
              "xml_fragment": "<ns0:date xmlns:ns0=\"http://www.tei-c.org/ns/1.0\" when=\"1856-02-04\">4 Feb [1856]</ns0:date>"
            }
          ]
        }
      ],
      "apparatus_rules": [
        "Footnote 1 supplies the relational 1856 date from the 25 December [1855] Shaw letter.",
        "Footnote 4’s Variation citation establishes later information, not February receipt or full incoming text."
      ],
      "exact_source_evidence": [
        {
          "letter_id": "DCP-LETT-3059",
          "body_paragraph": 1,
          "quote": "At Mr Shaw’s suggestion I wrote to Revd. Erdhardt, several weeks ago",
          "char_start": 151,
          "char_end": 219,
          "source_sha256": "a0e2905eb9ba1322246acdbfbc24331b2d674d3d8d4fc298349830e853522e65",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-3059",
          "body_paragraph": 1,
          "quote": "but anyhow I have had no answer",
          "char_start": 486,
          "char_end": 517,
          "source_sha256": "a0e2905eb9ba1322246acdbfbc24331b2d674d3d8d4fc298349830e853522e65",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-3059",
          "body_paragraph": 1,
          "quote": "But pray do not take trouble to answer this",
          "char_start": 583,
          "char_end": 626,
          "source_sha256": "a0e2905eb9ba1322246acdbfbc24331b2d674d3d8d4fc298349830e853522e65",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        }
      ]
    },
    {
      "case": "2121 Barth material, unidentified signed enclosure and publication-stage boundary",
      "source_ids": [
        "DCP-LETT-2121"
      ],
      "requirement": "Keep Darwin’s July 7 [1857] ALS distinct from its unidentified signed enclosure. The enclosure may relate to the Royal Geographical Society, but that is an editorial possibility, not an identified document or synthetic incoming prompt. Darwin has information about Barth’s work and says he will read the work and ask questions if reading produces them; this is prospective reading, not completed reading. Preserve the distinction between the first three Barth volumes published in May 1857 and the later complete five-volume set. Later Variation discussion of cattle cannot replace the letter’s explicit decision not to take cattle in detail here.",
      "source_provenance": [
        {
          "letter_id": "DCP-LETT-2121",
          "source_path": "data/raw/dcp/1856-1857/pages/DCP-LETT-2121.html",
          "source_html_sha256": "2c23804b75e8235e223804f69e52013b3f5e4082c95f853b0d6f00e90dc221aa",
          "xml_path": "data/raw/epsilon/ab0d973bae05b54d68d82d068211015996cfec06/expansions/1856-1857/letters/DCP-LETT-2121.xml",
          "xml_sha256": "8e4fe49a771e3e5f0c4e3b2c23fb1a9017e93b4fa43f408ba70d3a9647e13048",
          "verified_xml_dates": [
            {
              "text": "7 July [1857]",
              "attributes": {
                "when": "1857-07-07"
              },
              "lower": "1857-07-07",
              "upper": "1857-07-07",
              "xml_fragment": "<ns0:date xmlns:ns0=\"http://www.tei-c.org/ns/1.0\" when=\"1857-07-07\">7 July [1857]</ns0:date>"
            }
          ]
        }
      ],
      "apparatus_rules": [
        "Footnote 2 leaves the signed item unidentified and only suggests an RGS connection.",
        "Footnote 3 dates the first three volumes to May 1857; preserve publication-stage uncertainty rather than rendering five volumes as already available."
      ],
      "exact_source_evidence": [
        {
          "letter_id": "DCP-LETT-2121",
          "body_paragraph": 1,
          "quote": "I return the enclosed signed",
          "char_start": 0,
          "char_end": 28,
          "source_sha256": "2c23804b75e8235e223804f69e52013b3f5e4082c95f853b0d6f00e90dc221aa",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-2121",
          "body_paragraph": 2,
          "quote": "information about Dr. Barths work which I will read",
          "char_start": 16,
          "char_end": 67,
          "source_sha256": "2c23804b75e8235e223804f69e52013b3f5e4082c95f853b0d6f00e90dc221aa",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[3]"
        },
        {
          "letter_id": "DCP-LETT-2121",
          "body_paragraph": 3,
          "quote": "If on reading I shd. have anything to ask",
          "char_start": 122,
          "char_end": 163,
          "source_sha256": "2c23804b75e8235e223804f69e52013b3f5e4082c95f853b0d6f00e90dc221aa",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[4]"
        }
      ],
      "apparatus_proof": [
        {
          "letter_id": "DCP-LETT-2121",
          "literal_text": "The item has not been identified",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[2]/div[2]/div[2]",
          "source_sha256": "2c23804b75e8235e223804f69e52013b3f5e4082c95f853b0d6f00e90dc221aa"
        },
        {
          "letter_id": "DCP-LETT-2121",
