      "exact_source_evidence": [
        {
          "letter_id": "DCP-LETT-1840",
          "body_paragraph": 1,
          "quote": "a month or six weeks ago your letter of the 4th of September",
          "char_start": 23,
          "char_end": 83,
          "source_sha256": "426b944d174f19cf0f6d3d21b5e33eb0ce3f4891096f616a90690f5e4c7409d1",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-1840",
          "body_paragraph": 1,
          "quote": "I have heard that our old ship is now a collier",
          "char_start": 757,
          "char_end": 804,
          "source_sha256": "426b944d174f19cf0f6d3d21b5e33eb0ce3f4891096f616a90690f5e4c7409d1",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
