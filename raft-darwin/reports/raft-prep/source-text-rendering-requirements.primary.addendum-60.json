          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[2]/div[3]/div[2]",
          "source_sha256": "2c23804b75e8235e223804f69e52013b3f5e4082c95f853b0d6f00e90dc221aa"
        }
      ]
