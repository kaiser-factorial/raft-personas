          "letter_id": "DCP-LETT-1840",
          "body_paragraph": 2,
          "quote": "for it weighs 40 sovereigns",
          "char_start": 228,
          "char_end": 255,
          "source_sha256": "426b944d174f19cf0f6d3d21b5e33eb0ce3f4891096f616a90690f5e4c7409d1",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[3]"
        },
        {
          "letter_id": "DCP-LETT-2056",
          "body_paragraph": 1,
          "quote": "a short time since your letter of September 14",
          "char_start": 11,
          "char_end": 57,
          "source_sha256": "bd06d8188b187db856b2ab05b65db52bccf873f1efbf45f35512ff275412a8d6",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-2056",
          "body_paragraph": 1,
          "quote": "We think of making him a Barrister",
          "char_start": 713,
          "char_end": 747,
          "source_sha256": "bd06d8188b187db856b2ab05b65db52bccf873f1efbf45f35512ff275412a8d6",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[2]"
        },
        {
          "letter_id": "DCP-LETT-2056",
          "body_paragraph": 2,
          "quote": "are coming to-morrow to lunch with me",
          "char_start": 206,
          "char_end": 243,
          "source_sha256": "bd06d8188b187db856b2ab05b65db52bccf873f1efbf45f35512ff275412a8d6",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[1]/div[2]/p[3]"
        }
      ],
      "apparatus_proof": [
        {
          "letter_id": "DCP-LETT-1840",
          "literal_text": "The manuscript of CD’s letter has not been found.",
          "dom_locator": "/html/body/div[7]/div/div/div/div/div[2]/div/div[3]/div[1]/div/div[2]/div[1]/div[2]",
