  "audits": [
    {
      "source_id": "DCP-LETT-1983",
      "response_or_candidate_id": "DCP-LETT-1986",
      "status": "candidate_only",
      "reason": "Existing batch-03 leaves Hooker’s manuscript verdict unmatched, although Hooker says he finished reading Darwin’s manuscript and Darwin immediately thanks him for the verdict and relief.",
      "response_scope": "Hooker’s manuscript assessment and Darwin’s response, paragraphs 1–3 of each; invitation/family material excluded.",
      "evidence": [
        {
          "letter_id": "DCP-LETT-1983",
          "body_paragraph": 1,
          "quote": "I have finished the reading of your mss. & have been very much delighted & instructed. Your case is a most strong one & gives me a much higher idea of change than I had previously entertained; &, though, as you know, nev",
          "source_path": "data/raw/dcp/1856-1857/pages/DCP-LETT-1983.html",
          "source_html_sha256": "5431beb8ef381396761cdf6bc189a57e6a9af7c8c4be5870393971451859becf"
        },
        {
