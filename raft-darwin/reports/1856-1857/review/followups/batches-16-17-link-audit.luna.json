        {
          "letter_id": "DCP-LETT-1733",
          "body_paragraph": 1,
          "quote": "I have received the young Cochin, Call Duck, & Sebright Bantam all safe, for which hearty thanks, & I congratulate you on your horrid work being more than half done. Your deeds are beyond thanks.—",
          "source_path": "data/raw/dcp/1851-1855/pages/DCP-LETT-1733.html",
          "source_html_sha256": "b8357b767bd0fefdb245f34ee693fd6b8c4f5e6a6013c2ba7d3c5e4043f74e8d",
          "dom_locator": "div#letter div.body-content; retained body block 1",
