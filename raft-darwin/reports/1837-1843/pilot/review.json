            "content_type": "text/html",
            "id": "DCP-LETT-444"
          }
        },
        {
          "letter_id": "DCP-LETT-445",
          "body_paragraph": 2,
          "locator": "div#letter div.body-content; retained body block 2",
          "quote": "I was very glad to get your letter;",
          "char_start": 0,
          "source": {
            "path": "data/raw/dcp/expansion-1837-1843-pilot/DCP-LETT-445.html",
            "url": "https://www.darwinproject.ac.uk/letter/?docId=letters/DCP-LETT-445.xml",
