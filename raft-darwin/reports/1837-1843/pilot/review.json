          "letter_id": "DCP-LETT-346",
          "body_paragraph": 1,
          "locator": "div#letter div.body-content; retained body block 1",
          "quote": "You enquired in yr. last letter about Lyell’s Speech;",
          "char_start": 689,
          "source": {
            "path": "data/raw/dcp/expansion-1837-1843-pilot/DCP-LETT-346.html",
            "url": "https://www.darwinproject.ac.uk/letter/?docId=letters/DCP-LETT-346.xml",
