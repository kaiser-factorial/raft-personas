      "rationale": "Darwin acknowledges Kemp's paper-letter and responds directly to its sandpit description, proposed wet ancient climate, and plant observations. Editorial notes explicitly identify the 2 October letter.",
      "evidence": [
        {
          "letter_id": "DCP-LETT-699",
          "body_paragraph": 1,
          "locator": "div#letter div.body-content; retained body block 1",
          "quote": "From that seeming delicasy I intertained the opinion, that the Climate had been much more moist when the seed was deposited,",
          "char_start": 1040,
          "source": {
            "path": "data/raw/dcp/expansion-1837-1843-pilot/DCP-LETT-699.html",
            "url": "https://www.darwinproject.ac.uk/letter/?docId=letters/DCP-LETT-699.xml",
            "retrieved_at": "2026-09-16T09:24:48.926404+00:00",
            "sha256": "6cc4a2e3008f2ed65f2183b00299d7ad36b72b4acb5c29d662e15a6cc255228e",
            "bytes": 121377,
            "http_status": 200,
            "etag": "\"ff05b536f6eeaae9c34eb7d8f4341ef8\"",
            "content_type": "text/html",
            "id": "DCP-LETT-699"
          }
        },
        {
          "letter_id": "DCP-LETT-701F",
          "body_paragraph": 1,
          "locator": "div#letter div.body-content; retained body block 1",
          "quote": "I write a line to inform you that your paper has reached me safely.",
          "char_start": 0,
          "source": {
            "path": "data/raw/dcp/expansion-1837-1843-pilot/DCP-LETT-701F.html",
            "url": "https://www.darwinproject.ac.uk/letter/?docId=letters/DCP-LETT-701F.xml",
            "retrieved_at": "2026-09-16T09:24:48.944280+00:00",
            "sha256": "a968259ad3d8ac163d71db78969d0686d6d87922cadc8f94759d5c26a7023c40",
            "bytes": 117730,
            "http_status": 200,
            "etag": "\"7cad4c393574df62f5362c7947746b37\"",
            "content_type": "text/html",
            "id": "DCP-LETT-701F"
          }
        },
        {
          "letter_id": "DCP-LETT-701F",
          "body_paragraph": 9,
          "locator": "div#letter div.body-content; retained body block 9",
          "quote": "I think your speculation about the former dampness of climate too bold",
          "char_start": 0,
          "source": {
            "path": "data/raw/dcp/expansion-1837-1843-pilot/DCP-LETT-701F.html",
            "url": "https://www.darwinproject.ac.uk/letter/?docId=letters/DCP-LETT-701F.xml",
