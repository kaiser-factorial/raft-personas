            "bytes": 112714,
            "http_status": 200,
            "etag": "\"7dcd99ef54b97b3d3c89b0df553a7066\"",
            "content_type": "text/html",
            "id": "DCP-LETT-711"
          }
        },
        {
          "letter_id": "DCP-LETT-711F",
          "body_paragraph": 1,
          "locator": "div#letter div.body-content; retained body block 1",
          "quote": "Allow me to express my respect at the pleasant tone of your last letter,",
          "char_start": 0,
          "source": {
            "path": "data/raw/dcp/expansion-1837-1843-pilot/DCP-LETT-711F.html",
            "url": "https://www.darwinproject.ac.uk/letter/?docId=letters/DCP-LETT-711F.xml",
