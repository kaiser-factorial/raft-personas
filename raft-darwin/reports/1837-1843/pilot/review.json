            "id": "DCP-LETT-445"
          }
        },
        {
          "letter_id": "DCP-LETT-445",
          "body_paragraph": 2,
          "locator": "div#letter div.body-content; retained body block 2",
          "quote": "You say Caroline Tollet has two works to read, & that you could read one, if not already read,",
          "char_start": 102,
          "source": {
