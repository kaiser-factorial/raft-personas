          "body_paragraph": 4,
          "locator": "div#letter div.body-content; retained body block 4",
          "quote": "Caroline Tollet says in her situation she finds she can read nothing but sermons & Nicholas Nickleby.",
          "char_start": 129,
          "source": {
            "path": "data/raw/dcp/expansion-1837-1843-pilot/DCP-LETT-444.html",
            "url": "https://www.darwinproject.ac.uk/letter/?docId=letters/DCP-LETT-444.xml",
