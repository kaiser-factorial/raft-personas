            "bytes": 114691,
            "http_status": 200,
            "etag": "\"bae6259e74eec94243983240fa8509c2\"",
            "content_type": "text/html",
            "id": "DCP-LETT-711F"
          }
        },
        {
          "letter_id": "DCP-LETT-711F",
          "body_paragraph": 3,
          "locator": "div#letter div.body-content; retained body block 3",
          "quote": "With your permission I will draw up a short statement with as little theory as possible & will send it you for your approval.",
          "char_start": 0,
          "source": {
            "path": "data/raw/dcp/expansion-1837-1843-pilot/DCP-LETT-711F.html",
            "url": "https://www.darwinproject.ac.uk/letter/?docId=letters/DCP-LETT-711F.xml",
